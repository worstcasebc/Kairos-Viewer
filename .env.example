# Angaben für Impressum und Datenschutzerklärung der Web-Version.
# Kopieren nach .env.local (nicht versioniert) und ausfüllen; npm run build:web setzt die Werte ins HTML ein.
# Werte werden unverändert als HTML eingefügt: & als &amp; und < als &lt; schreiben.
VITE_LEGAL_NAME="Vorname Nachname"
VITE_LEGAL_STREET="Straße 1"
VITE_LEGAL_CITY="12345 Ort"
VITE_LEGAL_EMAIL="kontakt@example.de"
VITE_LEGAL_LOG_RETENTION="7 Tagen"
VITE_LEGAL_HOSTING="Die Seite wird auf einem eigenen Server betrieben."
VITE_LEGAL_AUTHORITY="bei der für Sie zuständigen Datenschutz-Aufsichtsbehörde"
VITE_LEGAL_DATE="1. Januar 2026"
