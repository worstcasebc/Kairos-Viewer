{
  "name": "kairos-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:web": "tsc --noEmit && vite build --config vite.web.config.ts",
    "dev:web": "vite --config vite.web.config.ts",
    "preview:web": "npm run build:web && node scripts/serve-web.mjs",
    "test": "vitest run",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/sql.js": "^1.4.11",
    "jsdom": "^25",
    "typescript": "^5.6",
    "vite": "^6",
    "vitest": "^3"
  }
}
